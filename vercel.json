{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npx next build",
  "rewrites": [
    {
      "source": "/morning",
      "destination": "https://morning-weight-pi.vercel.app/morning/"
    },
    {
      "source": "/morning/:path*",
      "destination": "https://morning-weight-pi.vercel.app/morning/:path*"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "integration/morning-route": false
    }
  }
}
